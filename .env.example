# ========================================================
# StockBridge Backend Environment Configuration
# Copy this file to .env or .env.local to customize locally
# ========================================================

# Server Port & Active Profile
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Shared Secret API Key (MUST match BACKEND_API_KEY in StockBridgeFront/.env.local)
BACKEND_API_KEY=dev-stockbridge-api-key-2026

# JWT Authentication Secret (256-bit secret) & Expiry (24 hours)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated; no wildcard)
ALLOWED_ORIGINS=http://localhost:3000

# Local PostgreSQL Database Credentials (Docker default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockbridge
SPRING_DATASOURCE_USERNAME=stockbridge
SPRING_DATASOURCE_PASSWORD=stockbridge
