# ========================================================
# StockBridge Backend Environment Configuration Template
# Copy this file to .env or .env.local to customize locally
# ========================================================

# Server Port & Active Profile
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Shared Secret API Key (MUST match BACKEND_API_KEY in StockBridgeFront/.env.local)
BACKEND_API_KEY=your_shared_backend_api_key_here

# JWT Authentication Secret (Must be a secure 256-bit / 32+ character key. NEVER commit production secrets!)
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_at_least_32_chars_long

# JWT Expiration in Milliseconds (Default: 86400000 ms = 24 hours)
# Common durations:
#   1 hour   = 3600000
#   24 hours = 86400000 (1 day)
#   7 days   = 604800000
#   30 days  = 2592000000
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated; no wildcard)
ALLOWED_ORIGINS=http://localhost:3000

# Local PostgreSQL Database Credentials (Docker default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockbridge
SPRING_DATASOURCE_USERNAME=stockbridge
SPRING_DATASOURCE_PASSWORD=stockbridge

# MongoDB URI (audit trails / documents)
MONGODB_URI=mongodb://localhost:27017/stockbridge
MONGODB_DATABASE=stockbridge
